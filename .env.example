# Application Environment
NODE_ENV=development
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_ROTATION_SIZE=10m
LOG_RETENTION_DAYS=7

# Optional Health Check HTTP Endpoint (127.0.0.1 recommended on VPS)
HEALTH_ENABLED=false
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3001

# Comma-separated Telegram User IDs allowed to run /health in private chat
BOT_OWNER_IDS=

# Telegram Bot Configuration (Required)
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username

# Database Configuration (SQLite for local/dev; PostgreSQL-ready via Prisma)
DATABASE_URL="file:./dev.db"

# Webhook Configuration (Optional; long polling is used when false)
WEBHOOK_ENABLED=false
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegraf
PORT=3000

# ==========================================================
# External API Integrations (Global Bot Configuration)
# ==========================================================
HTTP_TIMEOUT_MS=8000

# Optional AI Integration (/ai) - OpenAI-compatible provider (openai | openrouter | custom)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_MAX_TOKENS=500

# Optional News Integration (/news) - gnews | newsapi
NEWS_PROVIDER=gnews
NEWS_API_KEY=

# Translation Integration (/translate) - mymemory (keyless default) | libretranslate
TRANSLATE_PROVIDER=mymemory
TRANSLATE_API_URL=https://libretranslate.com/translate
TRANSLATE_API_KEY=

# Optional GitHub Personal Access Token (/github) for higher public API rate limits
GITHUB_TOKEN=
